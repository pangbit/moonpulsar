///|
import {
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/io",
  "moonbitlang/async@0.22.1/shell",
  "moonbitlang/core/bench",
  "moonbitlang/core/env",
  "moonbitlang/core/json",
  "moonbitlang/core/string",
}

///|
fn field(j : Json, key : String) -> Json raise {
  match j {
    Object(m) =>
      match m.get(key) {
        Some(v) => v
        None => fail("missing field: " + key)
      }
    _ => fail("expected object")
  }
}

///|
fn number(j : Json, key : String) -> Double raise {
  match field(j, key) {
    Number(n, ..) => n
    String(s) => @string.parse_double(s)
    _ => fail("expected number: " + key)
  }
}

///|
fn string(j : Json, key : String) -> String raise {
  match field(j, key) {
    String(s) => s
    _ => fail("expected string: " + key)
  }
}

///|
fn array(j : Json) -> Array[Json] raise {
  match j {
    Array(a) => a
    _ => fail("expected array")
  }
}

///|
fn words(s : StringView) -> Array[String] {
  s
  .to_owned()
  .replace(old="\t", new=" ")
  .split(" ")
  .filter(x => !x.is_empty())
  .map(x => x.to_owned())
  .to_array()
}

///|
fn label(s : String) -> Bool {
  !s.is_empty() &&
  s.length() <= 80 &&
  s
  .iter()
  .all(c => (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-')
}

///|
async fn read(path : String) -> Json {
  @fs.read_file(path).json()
}

///|
async fn append(path : String, value : Json) -> Unit {
  @fs.write_file(
    path,
    value.stringify() + "\n",
    create_mode=OpenOrCreate,
    append=true,
  )
}

///|
async fn records(path : String) -> Array[Json] {
  let result : Array[Json] = []
  for line in @fs.read_file(path).text().split("\n") {
    if !line.is_empty() {
      result.push(@json.parse(line))
    }
  }
  result
}

///|
async fn checkpoint(
  dir : String,
  state : String,
  phase : String,
  id : String,
) -> Unit {
  let value : Json = { "state": state, "phase": phase, "case_id": id }
  @fs.write_file(dir + "/status.tmp", value.stringify(indent=2))
  @shell.Cmd("mv", [dir + "/status.tmp", dir + "/status.json"]).run()
}

///|
async fn host() -> Json {
  let mem : Map[String, Double] = Map([])
  for line in @fs.read_file("/proc/meminfo").text().split("\n") {
    let parts = words(line)
    if parts.length() >= 2 {
      mem[parts[0]] = @string.parse_double(parts[1])
    }
  }
  let vm : Map[String, Double] = Map([])
  for line in @fs.read_file("/proc/vmstat").text().split("\n") {
    let parts = words(line)
    if parts.length() == 2 &&
      ["pswpin", "pswpout", "pgmajfault"].contains(parts[0]) {
      vm[parts[0]] = @string.parse_double(parts[1])
    }
  }
  {
    "memory_total_kib": mem["MemTotal:"],
    "memory_available_kib": mem["MemAvailable:"],
    "swap_used_kib": mem["SwapTotal:"] - mem["SwapFree:"],
    "swap_in_pages": vm["pswpin"],
    "swap_out_pages": vm["pswpout"],
    "major_faults": vm["pgmajfault"],
  }
}

///|
async fn disk(dir : String) -> Double {
  let output = @shell.Cmd("df", ["--output=avail", "-B1", dir]).output()
  output.check()
  @string.parse_double(output.stdout().split("\n").to_array()[1].trim())
}

///|
fn memory_ok(h : Json, preflight : Bool) -> Bool raise {
  number(h, "memory_available_kib") >=
  (if preflight { 4194304.0 } else { 2097152.0 })
}

///|
async fn process(pid : String, role : String) -> Json {
  let stat = @fs.read_file("/proc/" + pid + "/stat").text()
  let parts = words(stat.split(") ").to_array()[1])
  let mut rss = 0.0
  for line in @fs.read_file("/proc/" + pid + "/status").text().split("\n") {
    if line.has_prefix("VmRSS:") {
      rss = @string.parse_double(words(line)[1])
    }
  }
  {
    "role": role,
    "pid": pid,
    "start_ticks": parts[19],
    "rss_kib": rss,
    "cpu_ticks": @string.parse_double(parts[11]) +
    @string.parse_double(parts[12]),
  }
}

///|
fn validate_samples(samples : Array[Json], expected_s : Double) -> Json raise {
  guard samples.length() >= 3 else {
    fail("fewer than three persisted samples")
  }
  let mut previous = -1.0
  let mut max_gap = 0.0
  for i, sample in samples {
    guard number(sample, "sequence") == i.to_double() else {
      fail("sample sequence gap")
    }
    let elapsed = number(sample, "elapsed_ms")
    guard elapsed > previous else { fail("sample time not increasing") }
    if i > 0 {
      max_gap = max_gap.max(elapsed - previous)
    }
    previous = elapsed
    guard number(field(sample, "host"), "memory_available_kib") >= 0.0 else {
      fail("invalid host sample")
    }
  }
  guard number(samples[0], "elapsed_ms") <= 5000.0 && max_gap <= 5000.0 else {
    fail("sampling gap exceeds five seconds")
  }
  guard previous >= (expected_s - 3.0) * 1000.0 &&
    samples.length().to_double() >= expected_s * 0.9 else {
    fail("insufficient sampling coverage")
  }
  {
    "sample_count": samples.length(),
    "last_sample_s": previous / 1000.0,
    "max_gap_s": max_gap / 1000.0,
  }
}

///|
fn validate_roles(
  samples : Array[Json],
  warmup : Int,
  duration : Int,
) -> Unit raise {
  let window = samples.filter(s => {
    number(s, "elapsed_ms") >= (warmup + 5000).to_double() &&
    number(s, "elapsed_ms") <= (warmup + duration - 5000).to_double()
  })
  guard window.length() >= 3 else {
    fail("insufficient common measurement window")
  }
  for role in ["producer", "consumer", "broker"] {
    let mut identity : Json = null
    let mut found = 0
    let mut previous_ticks = -1.0
    for sample in window {
      let processes = array(field(sample, "processes")).filter(p => {
        field(p, "role") == role.to_json()
      })
      guard processes.length() <= 1 else { fail("multiple processes for role") }
      if processes.length() == 1 {
        let p = processes[0]
        let current : Json = [field(p, "pid"), field(p, "start_ticks")]
        if identity == null {
          identity = current
        }
        guard identity == current else { fail("process identity changed") }
        let ticks = number(p, "cpu_ticks")
        guard ticks >= previous_ticks else { fail("CPU counter decreased") }
        previous_ticks = ticks
        found += 1
      }
    }
    guard found.to_double() >= window.length().to_double() * 0.95 else {
      fail("process sampling coverage below 95 percent: " + role)
    }
  }
}

///|
async fn preflight(dir : String, seconds : Int) -> Unit {
  let clock = @bench.monotonic_clock_start()
  let initial = host()
  for i in 0..<seconds {
    let h = host()
    append(dir + "/preflight.jsonl", {
      "sequence": i,
      "elapsed_ms": @bench.monotonic_clock_end(clock) / 1000.0,
      "host": h,
    })
    guard memory_ok(h, true) else {
      fail("preflight requires at least 4 GiB available memory")
    }
    guard number(h, "swap_out_pages") - number(initial, "swap_out_pages") <=
      1024.0 else {
      fail("active host swapping during preflight")
    }
    guard disk(dir) >= 21474836480.0 else {
      fail("preflight requires 20 GiB free disk")
    }
    @async.sleep(1000)
  }
  ignore(
    validate_samples(records(dir + "/preflight.jsonl"), seconds.to_double()),
  )
}

///|
async fn admin(token : String, verb : String, path : String) -> @shell.Output {
  @shell.Cmd(
    "curl",
    [
      "-sS",
      "--max-time",
      "10",
      "--config",
      "-",
      "-X",
      verb,
      "-w",
      "\n%{http_code}",
      @env.get_env_var("PULSAR_ADMIN_URL").unwrap() + path,
    ],
    stdin=Text("header = \"Authorization: Bearer " + token + "\"\n"),
  ).output()
}

///|
async fn monitor(
  config : Json,
  token : String,
  path : String,
  topic : String,
  dir : String,
  done : Ref[Bool],
) -> Unit {
  let clock = @bench.monotonic_clock_start()
  let binary = string(config, "binary")
  let pid = string(config, "broker_pid")
  let rate = number(config, "rate")
  let mut index = 0
  let mut high_backlog = 0
  while !done.val {
    let start = @bench.monotonic_clock_end(clock)
    let processes : Array[Json] = []
    // Match the exact executable and topic, not other benchmarks using that executable.
    let pids = @shell.Cmd("pgrep", ["-f", binary]).output()
    guard pids.exit_code() == 0 || pids.exit_code() == 1 else {
      fail("process discovery failed")
    }
    for pid in pids.stdout().trim().split("\n") {
      if pid.is_empty() {
        continue
      }
      let item = try {
        let p = pid.to_owned()
        let executable = @shell.Cmd("readlink", ["/proc/" + p + "/exe"]).output()
        let env = @fs.read_file("/proc/" + p + "/environ")
          .text()
          .split("\u0000")
          .to_array()
        if executable.stdout().trim() == binary &&
          env.contains(("PULSAR_TOPIC=" + topic)[:]) {
          let role = if env.contains("PULSAR_PERF_MODE=produce") {
            "producer"
          } else {
            "consumer"
          }
          Some(process(p, role))
        } else {
          None
        }
      } catch {
        _ => None
      }
      if item is Some(p) {
        processes.push(p)
      }
    }
    processes.push(process(pid, "broker"))
    let output = admin(token, "GET", path + "/stats")
    guard output.exit_code() == 0 && output.stdout().has_suffix("\n200") else {
      fail("topic statistics unavailable")
    }
    let stats = @json.parse(output.stdout().strip_suffix("\n200").unwrap())
    let mut backlog = 0.0
    match field(stats, "subscriptions") {
      Object(subs) =>
        for _, sub in subs {
          backlog += number(sub, "msgBacklog")
        }
      _ => fail("missing subscriptions")
    }
    let h = host()
    append(dir + "/samples.jsonl", {
      "sequence": index,
      "elapsed_ms": @bench.monotonic_clock_end(clock) / 1000.0,
      "host": h,
      "processes": processes,
      "backlog": backlog,
      "messages_in": number(stats, "msgInCounter"),
      "messages_out": number(stats, "msgOutCounter"),
    })
    // Write the failing observation before applying a guard.
    guard memory_ok(h, false) else {
      fail("host memory guard: below 2 GiB available")
    }
    high_backlog = if backlog > rate * 10.0 { high_backlog + 1 } else { 0 }
    guard high_backlog < 30 else { fail("persistent backlog guard") }
    if index == 2 || index % 60 == 59 {
      let saved = records(dir + "/samples.jsonl")
      guard saved.length() == index + 1 else {
        fail("persisted sample count mismatch")
      }
      ignore(
        validate_samples(saved, @bench.monotonic_clock_end(clock) / 1000000.0),
      )
    }
    if index % 10 == 0 {
      guard disk(dir) >= 21474836480.0 else {
        fail("disk guard: below 20 GiB free")
      }
    }
    index += 1
    let remaining = 1000.0 -
      (@bench.monotonic_clock_end(clock) - start) / 1000.0
    if remaining > 0.0 {
      @async.sleep(remaining.ceil().to_int())
    }
  }
}

///|
fn validate_config(c : Json) -> Unit raise {
  guard label(string(c, "case_id")) && label(string(c, "topic_prefix")) else {
    fail("case and topic prefix must be lowercase ASCII labels")
  }
  guard ["moon", "go", "rust"].contains(string(c, "client")) else {
    fail("invalid client")
  }
  for key in ["binary", "output_dir"] {
    guard string(c, key).has_prefix("/") else {
      fail("absolute path required: " + key)
    }
  }
  guard @string.parse_int(string(c, "broker_pid")) > 0 else {
    fail("invalid broker pid")
  }
  for
    key in [
      "producer_cpu", "consumer_cpu", "warmup_ms", "duration_ms", "size", "rate",
    ] {
    let n = number(c, key)
    guard n >= 0.0 && n <= 86400000.0 && n.floor() == n else {
      fail("invalid integer: " + key)
    }
  }
  guard number(c, "producer_cpu") != number(c, "consumer_cpu") else {
    fail("CPU assignments must differ")
  }
  guard number(c, "size") >= 1.0 &&
    number(c, "size") <= 1048576.0 &&
    number(c, "rate") >= 1.0 else {
    fail("invalid load")
  }
  let phase = string(c, "phase")
  let warmup = number(c, "warmup_ms")
  let duration = number(c, "duration_ms")
  guard (
      phase == "smoke" &&
      warmup >= 1000.0 &&
      duration >= 15000.0 &&
      duration <= 60000.0
    ) ||
    (phase == "compare" && warmup >= 120000.0 && duration >= 900000.0) ||
    (phase == "soak" && warmup >= 120000.0 && duration >= 7200000.0) else {
    fail("invalid phase duration")
  }
}

///|
async fn verify(dir : String) -> Json {
  let c = read(dir + "/config.json")
  validate_config(c)
  let warmup = number(c, "warmup_ms").to_int()
  let duration = number(c, "duration_ms").to_int()
  let samples = records(dir + "/samples.jsonl")
  let coverage = validate_samples(
    samples,
    (warmup + duration).to_double() / 1000.0,
  )
  validate_roles(samples, warmup, duration)
  let exits = read(dir + "/exits.json")
  guard number(exits, "producer") == 0.0 && number(exits, "consumer") == 0.0 else {
    fail("unsuccessful process exit")
  }
  for role in ["prime", "ready", "producer", "consumer"] {
    guard @fs.read_file(dir + "/" + role + ".stderr").text() == "" else {
      fail("nonempty stderr")
    }
    guard field(read(dir + "/" + role + ".json"), "status") == "complete" else {
      fail("incomplete adapter output")
    }
  }
  guard number(read(dir + "/ready.json"), "messages") > 0.0 else {
    fail("readiness has no messages")
  }
  let p = read(dir + "/producer.json")
  let consumer = read(dir + "/consumer.json")
  let send = number(p, "messages_per_second")
  let receive = number(consumer, "messages_per_second")
  guard (number(p, "messages") / send - duration.to_double() / 1000.0).abs() <
    0.01 &&
    (number(consumer, "messages") / receive -
    (duration - 3000).to_double() / 1000.0).abs() <
    0.01 else {
    fail("measurement duration mismatch")
  }
  let latency = field(p, "send_receipt_latency")
  guard number(latency, "overflow_count") == 0.0 else {
    fail("latency histogram overflow")
  }
  let rate = number(c, "rate")
  // Performance targets describe the result; they do not invalidate evidence.
  let send_met = send >= rate * 0.98
  let receive_met = receive >= rate * 0.95
  let latency_met = number(latency, "p99") <= 250000.0
  {
    "case_id": string(c, "case_id"),
    "client": string(c, "client"),
    "phase": string(c, "phase"),
    "size": number(c, "size"),
    "target_rate": rate,
    "measurement_s": duration.to_double() / 1000.0,
    "send_msg_s": send,
    "receive_msg_s": receive,
    "p99_ms": number(latency, "p99") / 1000.0,
    "coverage": coverage,
    "evidence_valid": true,
    "performance_targets_met": send_met && receive_met && latency_met,
    "performance_targets": {
      "send_min_fraction": 0.98,
      "receive_min_fraction": 0.95,
      "p99_max_ms": 250,
      "send_met": send_met,
      "receive_met": receive_met,
      "p99_met": latency_met,
    },
  }
}

///|
async fn run(c : Json) -> Unit {
  validate_config(c)
  let dir = string(c, "output_dir")
  let id = string(c, "case_id")
  // Refuse to overwrite either successful or failed evidence; every attempt is new.
  guard !@fs.exists(dir) else { fail("output directory already exists") }
  @fs.mkdir(dir)
  @fs.write_file(dir + "/config.json", c.stringify(indent=2))
  let phase : Ref[String] = { val: "preflight", }
  errdefer checkpoint(dir, "failed", phase.val, id)
  checkpoint(dir, "running", phase.val, id)
  let token = @env.get_env_var("PULSAR_TOKEN").unwrap_or("")
  guard token != "" else { fail("connection environment missing") }
  guard !token.contains("\n") &&
    !token.contains("\r") &&
    !token.contains("\"") &&
    !token.contains("\\") else {
    fail("unsupported token characters")
  }
  guard @env.get_env_var("PULSAR_URL").unwrap_or("") != "" &&
    @env.get_env_var("PULSAR_ADMIN_URL").unwrap_or("") != "" else {
    fail("connection environment missing")
  }
  preflight(dir, 30)
  let binary = string(c, "binary")
  let hash = @shell.Cmd("sha256sum", [binary]).output()
  hash.check()
  @fs.write_file(dir + "/binary-sha256.txt", hash.stdout())
  let ticks = @shell.Cmd("getconf", ["CLK_TCK"]).output()
  ticks.check()
  @fs.write_file(dir + "/clock-ticks.txt", ticks.stdout())
  let topic_name = string(c, "topic_prefix") + "-" + id
  let topic = "persistent://public/default/" + topic_name
  let path = "/admin/v2/persistent/public/default/" + topic_name
  phase.val = "readiness"
  checkpoint(dir, "running", phase.val, id)
  let old = admin(token, "GET", path + "/stats")
  guard old.exit_code() == 0 && old.stdout().has_suffix("\n404") else {
    fail("topic is not fresh")
  }
  let created = admin(token, "PUT", path)
  guard created.exit_code() == 0 && created.stdout().has_suffix("\n204") else {
    fail("topic creation failed")
  }
  @fs.write_file(dir + "/created-topic.txt", topic)
  let env : Map[String, String] = {
    "PULSAR_URL": @env.get_env_var("PULSAR_URL").unwrap(),
    "PULSAR_TOKEN": token,
    "PULSAR_TOPIC": topic,
    "PULSAR_SUBSCRIPTION": "perf-" + id,
    "PERF_SIZE": number(c, "size").to_int().to_string(),
    "PERF_CONCURRENCY": "32",
    "PERF_RATE": number(c, "rate").to_int().to_string(),
    "PERF_BATCH_MESSAGES": "100",
    "PERF_BATCH_DELAY_MS": "1",
    "PERF_QUEUE_SIZE": "1000",
    "PERF_TIMEOUT_MS": "10000",
    "GOMAXPROCS": "1",
  }
  let prime = env.copy()
  prime["PERF_CONCURRENCY"] = "1"
  prime["PERF_RATE"] = "100"
  prime["PERF_BATCH_MESSAGES"] = "0"
  prime["PERF_WARMUP_MS"] = "0"
  prime["PERF_DURATION_MS"] = "1000"
  for (name, mode) in [("prime", "produce"), ("ready", "consume")] {
    prime["PULSAR_PERF_MODE"] = mode
    guard @shell.Cmd(
        binary,
        [],
        env=prime,
        stdout=ToFile(dir + "/" + name + ".json"),
        stderr=ToFile(dir + "/" + name + ".stderr"),
      ).status(timeout_ms=30000) ==
      0 else {
      fail("readiness process failed")
    }
  }
  let warmup = number(c, "warmup_ms").to_int()
  let duration = number(c, "duration_ms").to_int()
  let done : Ref[Bool] = { val: false, }
  let pexit : Ref[Int] = { val: -1, }
  let cexit : Ref[Int] = { val: -1, }
  phase.val = "load"
  checkpoint(dir, "running", phase.val, id)
  @async.with_task_group(async fn(group) {
    group.spawn_bg(async fn() { monitor(c, token, path, topic, dir, done) })
    @async.with_task_group(async fn(pair) {
      pair.spawn_bg(async fn() {
        let e = env.copy()
        e["PULSAR_PERF_MODE"] = "consume"
        e["PERF_WARMUP_MS"] = (warmup + 4000).to_string()
        e["PERF_DURATION_MS"] = (duration - 3000).to_string()
        cexit.val = @shell.Cmd(
          "/usr/bin/time",
          [
            "-v",
            "-o",
            dir + "/consumer.time",
            "taskset",
            "-c",
            number(c, "consumer_cpu").to_int().to_string(),
            binary,
          ],
          env=e,
          stdout=ToFile(dir + "/consumer.json"),
          stderr=ToFile(dir + "/consumer.stderr"),
        ).status(timeout_ms=warmup + duration + 60000)
        guard cexit.val == 0 else { fail("consumer failed") }
      })
      @async.sleep(2000)
      let e = env.copy()
      e["PULSAR_PERF_MODE"] = "produce"
      e["PERF_WARMUP_MS"] = warmup.to_string()
      e["PERF_DURATION_MS"] = duration.to_string()
      pexit.val = @shell.Cmd(
        "/usr/bin/time",
        [
          "-v",
          "-o",
          dir + "/producer.time",
          "taskset",
          "-c",
          number(c, "producer_cpu").to_int().to_string(),
          binary,
        ],
        env=e,
        stdout=ToFile(dir + "/producer.json"),
        stderr=ToFile(dir + "/producer.stderr"),
      ).status(timeout_ms=warmup + duration + 60000)
      guard pexit.val == 0 else { fail("producer failed") }
    })
    done.val = true
  })
  @fs.write_file(
    dir + "/exits.json",
    { "producer": pexit.val, "consumer": cexit.val }.to_json(),
  )
  phase.val = "verification"
  checkpoint(dir, "running", phase.val, id)
  let result = verify(dir)
  @fs.write_file(dir + "/verification.json", result.stringify(indent=2))
  phase.val = "cleanup"
  checkpoint(dir, "running", phase.val, id)
  let deleted = admin(token, "DELETE", path)
  guard deleted.exit_code() == 0 && deleted.stdout().has_suffix("\n204") else {
    fail("dedicated topic cleanup failed")
  }
  @fs.write_file(dir + "/cleanup.txt", "204\n")
  checkpoint(dir, "complete", "verified", id)
  println(result.stringify())
}

///|
async fn self_test() -> Unit {
  let dir = @fs.tmpdir(prefix="perf-sampling-selftest-")
  let path = dir + "/samples.jsonl"
  for i in 0..<20 {
    let processes : Array[Json] = ["producer", "consumer", "broker"].map(role => {
      "role": role,
      "pid": "1",
      "start_ticks": "10",
      "cpu_ticks": i,
      "rss_kib": 1024,
    })
    append(path, {
      "sequence": i,
      "elapsed_ms": i * 1000 + 1,
      "host": { "memory_available_kib": 5000000 },
      "processes": processes,
    })
  }
  let samples = records(path)
  assert_eq(samples.length(), 20)
  ignore(validate_samples(samples, 20.0))
  validate_roles(samples, 1000, 15000)
  let truncated = [samples[19]]
  assert_true(
    try {
      ignore(validate_samples(truncated, 20.0))
      false
    } catch {
      _ => true
    },
  )
  let missing = samples.copy()
  ignore(missing.remove(5))
  assert_true(
    try {
      ignore(validate_samples(missing, 20.0))
      false
    } catch {
      _ => true
    },
  )
  assert_true(
    try {
      ignore(validate_samples(samples, 120.0))
      false
    } catch {
      _ => true
    },
  )
  let no_roles : Array[Json] = samples.map(s => {
    "sequence": number(s, "sequence"),
    "elapsed_ms": number(s, "elapsed_ms"),
    "host": field(s, "host"),
    "processes": [],
  })
  assert_true(
    try {
      validate_roles(no_roles, 1000, 15000)
      false
    } catch {
      _ => true
    },
  )
  assert_true(!memory_ok({ "memory_available_kib": 2000000 }, false))
  assert_true(!memory_ok({ "memory_available_kib": 3000000 }, true))
  println(
    "PASS append persistence, truncated/gapped/short sampling rejection, role coverage, memory guards",
  )
}

///|
async fn main {
  let args = @env.args().filter(x => x != "--")
  match args {
    [_, "--self-test"] => self_test()
    [_, "--probe-host", dir] => {
      guard !@fs.exists(dir) else { fail("output directory exists") }
      @fs.mkdir(dir)
      preflight(dir, 10)
      println("PASS host preflight and persisted sampling")
    }
    [_, "--validate-config", file] => {
      validate_config(read(file))
      println("PASS configuration")
    }
    [_, "--verify", dir] => println(verify(dir).stringify())
    [_, "--run", file] => run(read(file))
    _ =>
      fail(
        "usage: --self-test | --probe-host NEW_DIR | --validate-config CONFIG | --run CONFIG | --verify DIR",
      )
  }
}
