///|
// Check inline Markdown file links in the checkout and, optionally, a ZIP.
// Repository URLs are checked against local files, not fetched over the network.
import {
  "moonbitlang/async@0.22.1",
  "moonbitlang/async@0.22.1/fs",
  "moonbitlang/async@0.22.1/shell",
  "moonbitlang/core/env",
}

///|
fn normalize(path : String) -> String {
  let prefix = if path.has_prefix("/") { "/" } else { "" }
  let parts : Array[String] = []
  for part in path.split("/") {
    match part.to_owned() {
      "" | "." => ()
      ".." =>
        if parts.last() is Some(last) && last != ".." {
          ignore(parts.pop())
        } else if prefix.is_empty() {
          parts.push("..")
        }
      value => parts.push(value)
    }
  }
  prefix + parts.join("/")
}

///|
async fn check_links(
  path : String,
  content : String,
  archive_files : Set[String]?,
) -> Int {
  let parts = path.split("/").to_array()
  let base = parts[:parts.length() - 1]
    .to_owned()
    .map(v => v.to_owned())
    .join("/")
  let chunks = content.split("](").to_array()
  let mut count = 0
  for i in 1..<chunks.length() {
    let target = chunks[i].to_owned().split(")").to_array()[0].to_owned()
    let file = target.split("#").to_array()[0].to_owned()
    if file.is_empty() || file.has_prefix("mailto:") {
      continue
    }
    let mut repo_path : String? = None
    for kind in ["blob", "tree"] {
      let prefix = "https://github.com/pangbit/moonpulsar/\{kind}/main/"
      if file.has_prefix(prefix) {
        repo_path = Some(file[prefix.length():].to_owned())
      }
    }
    if repo_path is Some(resolved) {
      assert_true(
        @fs.exists(resolved),
        msg="missing repository target: \{path} -> \{target}",
      )
    } else if !file.contains("://") {
      let resolved = if file.has_prefix("/") {
        normalize(file)
      } else {
        normalize(if base.is_empty() { file } else { base + "/" + file })
      }
      let exists = match archive_files {
        Some(files) => files.contains(resolved)
        None => @fs.exists(resolved)
      }
      assert_true(exists, msg="missing local target: \{path} -> \{target}")
    } else {
      continue
    }
    count += 1
  }
  count
}

///|
async fn main {
  let args = @env.args()
  if args.length() == 2 && args[1] == "--self-test" {
    assert_eq(normalize("docs/../README.md"), "README.md")
    assert_eq(normalize("/tmp/run/../record.tar"), "/tmp/record.tar")
    assert_eq(normalize("docs/../../README.md"), "../README.md")
    let files : Set[String] = Set(["README.md", "docs/guide.md"])
    assert_eq(
      check_links("CHANGELOG.md", "[guide](docs/guide.md)", Some(files)),
      1,
    )
    assert_eq(
      check_links("docs/guide.md", "[root](../README.md)", Some(files)),
      1,
    )
    for target in ["missing.md", "/tmp/not-in-package.tar", "../../README.md"] {
      let rejected = try {
        ignore(check_links("docs/guide.md", "[bad](\{target})", Some(files)))
        false
      } catch {
        _ => true
      }
      assert_true(rejected)
    }
    println("PASS link normalization and package-boundary checks")
    return
  }
  let mut archive : String? = None
  let mut public_only = false
  let mut i = 1
  while i < args.length() {
    match args[i] {
      "--" => i += 1
      "--public" => {
        public_only = true
        i += 1
      }
      "--archive" if i + 1 < args.length() => {
        archive = Some(args[i + 1])
        i += 2
      }
      _ =>
        fail(
          "usage: check-doc-links.mbtx [--public --archive module.zip] | --self-test",
        )
    }
  }
  let mut archive_files : Set[String]? = None
  if archive is Some(zip) {
    let listing = @shell.Cmd("unzip", ["-Z1", zip]).output()
    listing.check()
    let files : Set[String] = Set([])
    for path in listing.stdout().split("\n") {
      if !path.is_empty() {
        files.add(path.to_owned())
      }
    }
    archive_files = Some(files)
  }
  let paths : Array[String] = []
  if public_only {
    guard archive_files is Some(files) else {
      fail("--public requires --archive")
    }
    for path in files {
      if path.has_suffix(".md") {
        paths.push(path)
      }
    }
  } else {
    let listing = @shell.Cmd("git", [
      "ls-files", "--cached", "--others", "--exclude-standard", "--", "*.md",
    ]).output()
    listing.check()
    for path in listing.stdout().split("\n") {
      if !path.is_empty() {
        paths.push(path.to_owned())
      }
    }
  }
  let mut count = 0
  for path in paths {
    if public_only {
      assert_true(
        @fs.exists(path),
        msg="archive Markdown missing from checkout: \{path}",
      )
    }
    if path.is_empty() || !@fs.exists(path) {
      continue
    }
    count += check_links(path, @fs.read_file(path).text(), None)
  }
  let scope = if public_only { "public checkout" } else { "full checkout" }
  println("PASS \{scope}: \{count} file links")
  if archive is Some(zip) {
    let files = archive_files.unwrap()
    let mut count = 0
    for path in files {
      if !path.has_suffix(".md") {
        continue
      }
      let content = @shell.Cmd("unzip", ["-p", zip, path]).output()
      content.check()
      if public_only {
        assert_eq(
          content.stdout(),
          @fs.read_file(path).text(),
          msg="stale archive Markdown: \{path}",
        )
      }
      count += check_links(path, content.stdout(), Some(files))
    }
    println("PASS archive: \{count} file links")
  }
}
